{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "nirs4all-ui": ["../../nirs4all-ui/src/index.ts"],
      "nirs4all-ui/score": ["../../nirs4all-ui/src/score/index.ts"],
      "nirs4all-ui/runtime": ["../../nirs4all-ui/src/runtime/index.ts"],
      "nirs4all-ui/components": ["../../nirs4all-ui/src/components/index.ts"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist", "dist-single", "public/wasm"]
}
