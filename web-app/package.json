{
  "name": "nirs4all-web",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "description": "nirs4all-web — single-page, full-WASM nirs4all browser client (upload → configure → pipeline → run via dag-ml/libn4m → results → predict, all in the browser).",
  "license": "(CECILL-2.1 OR AGPL-3.0-or-later)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode singlefile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:client-only": "vitest run --config vitest.config.ts src/app/client-side-only.test.ts",
    "test:watch": "vitest",
    "smoke": "node scripts/run-smokes.mjs",
    "smoke:predict-artifact": "node scripts/run-smokes.mjs n4a-roundtrip",
    "smoke:pipeline-repository": "node scripts/run-smokes.mjs pipeline-repository",
    "smoke:repository-best-pipeline": "node scripts/run-smokes.mjs repository-best-pipeline",
    "smoke:converted-predictions": "node scripts/run-smokes.mjs converted-predictions-render",
    "smoke:performance-compare": "node scripts/run-smokes.mjs performance-compare",
    "smoke:shared-ui-contract": "vitest run --config vitest.config.ts src/app/shared-ui-contract.test.ts",
    "smoke:custom-app-host": "vitest run --config vitest.config.ts src/app/custom-app-host.contract.test.ts",
    "smoke:custom-app-host-template": "vitest run --config vitest.config.ts src/app/custom-app-host-template.contract.test.ts",
    "smoke:published-custom-host": "node scripts/smoke-published-custom-host.mjs",
    "smoke:artifacts": "node scripts/run-smokes.mjs n4a-roundtrip pipeline-repository",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "vendor:core": "node scripts/sync-core-shim.mjs",
    "check:core-shim": "node scripts/sync-core-shim.mjs --check",
    "vendor:ui": "node scripts/sync-ui-shim.mjs",
    "check:ui-shim": "node scripts/sync-ui-shim.mjs --check",
    "wasm": "bash scripts/build-wasm.sh"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.487.0",
    "next-themes": "0.4.6",
    "nirs4all": "file:./vendor/nirs4all",
    "nirs4all-ui": "file:./vendor/nirs4all-ui",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.55.0",
    "react-resizable-panels": "2.1.7",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "^1.49.1",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.1.0",
    "vitest": "3.2.6"
  }
}
